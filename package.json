{
  "name": "gitnrun",
  "productName": "GitNRun",
  "version": "0.1.0",
  "description": "Local dev launcher for starting and restarting frontend/backend services.",
  "license": "Apache-2.0",
  "os": [
    "darwin"
  ],
  "homepage": "https://github.com/xiaochen26wyl/GitNRun#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaochen26wyl/GitNRun.git"
  },
  "bugs": {
    "url": "https://github.com/xiaochen26wyl/GitNRun/issues"
  },
  "private": true,
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:tauri": "tsx scripts/dev.ts",
    "build:sidecar": "tsx scripts/build-sidecar.ts",
    "prepare:node": "tsx scripts/prepare-node.ts",
    "build:tauri": "vite build && pnpm build:sidecar && pnpm prepare:node",
    "dist:tauri": "tauri build",
    "build": "vite build && pnpm build:sidecar",
    "test:unit": "tsx --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "check:boundary": "tsx scripts/check-boundary.ts",
    "smoke:build": "tsx scripts/smoke-tauri.ts",
    "smoke:tauri": "tsx scripts/smoke-tauri.ts",
    "dist:mac": "pnpm dist:tauri"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  },
  "packageManager": "pnpm@9.15.9"
}
