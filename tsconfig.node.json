{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@main/*": ["./src/main/*"]
    }
  },
  "include": [
    "vite.config.ts",
    "src/main/**/*.ts",
    "src/shared/**/*.ts",
    "src/renderer/ipc/create-api.ts",
    "src/renderer/ipc/methods.ts",
    "src/renderer/ipc/reload-policy.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts"
  ]
}
